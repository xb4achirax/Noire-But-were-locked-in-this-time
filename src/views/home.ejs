<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NOIRE — Engineered for the Relentless</title>
  <meta name="description"
    content="NOIRE is a premium athletic streetwear brand engineered for the relentless. Shop performance-driven apparel designed to conquer every limit." />
  <link rel="stylesheet" href="/css/home.css" />
  <link rel="stylesheet" href="/css/auth.css" />
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>◼</text></svg>" />
</head>

<body>

  <!-- Page Loader -->
  <div class="page-loader" id="pageLoader">
    <div class="loader-logo"><img src="/images/logo.png" alt="NOIRE" class="loader-logo-img" /></div>
    <div class="loader-bar-track">
      <div class="loader-bar-fill"></div>
    </div>
  </div>

  <!-- Cursor Glow (Desktop) -->
  <div class="cursor-glow" id="cursorGlow"></div>

  <!-- Announcement Bar -->
  <div class="announcement-bar" id="announcementBar">
    <span>Free shipping on orders over $100 &mdash; New Drop Available Now</span>
  </div>

  <!-- Navbar -->
  <nav class="navbar has-announcement" id="navbar">
    <!-- Left: Menu Links + Hamburger -->
    <div class="nav-left">
      <button class="hamburger" id="hamburger" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        <li><a href="/products/new-arrivals">New Arrivals</a></li>
        <li><a href="/products/men">Men</a></li>
        <li><a href="/products/women">Women</a></li>
        <li><a href="/products">All Products</a></li>
      </ul>
    </div>

    <!-- Center: Logo -->
    <div class="nav-center">
      <a href="/" class="nav-logo"><img src="/images/logo.png" alt="NOIRE" class="nav-logo-img" /></a>
    </div>

    <!-- Right: Icons -->
    <div class="nav-right">
      <!-- Search -->
      <button class="nav-icon" id="searchToggle" aria-label="Search">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
      </button>

      <!-- Profile -->
      <a href="#" class="nav-icon auth-toggle" aria-label="Account">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c0-4.418 3.582-8 8-8s8 3.582 8 8" />
        </svg>
      </a>

      <!-- Cart -->
      <a href="/cart" class="nav-icon" aria-label="Cart">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 6h15l-1.5 9h-12z" />
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="18" cy="20" r="1.5" />
          <path d="M1 1h4l1 5" />
        </svg>
        <span class="cart-badge">0</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/products/new-arrivals">New Arrivals</a>
    <a href="/products/men">Men</a>
    <a href="/products/women">Women</a>
    <a href="/products">All Products</a>
    <a href="#" class="auth-toggle">Account</a>
  </div>

  <!-- Search Overlay -->
  <div class="search-overlay" id="searchOverlay">
    <button class="search-close" id="searchClose" aria-label="Close search">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    <div class="search-container">
      <div class="search-input-wrap">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
        <input type="text" class="search-input" placeholder="Search products..." autofocus />
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <!-- Background Image -->
    <div class="hero-bg">
      <img src="/images/hero-bg.png" alt="NOIRE Athletic Apparel" />
    </div>

    <!-- Overlays -->
    <div class="hero-overlay"></div>
    <div class="hero-vignette"></div>
    <div class="hero-grain"></div>

    <!-- Floating Particles -->
    <div class="particles-container" id="particles"></div>

    <!-- Floating Badges -->
    <div class="hero-float-badge left" id="floatLeft">
      <span class="float-icon">🔥</span>
      <span>Trending Now</span>
    </div>
    <div class="hero-float-badge right" id="floatRight">
      <span class="float-icon">⚡</span>
      <span>New Drop Live</span>
    </div>

    <!-- Hero Content -->
    <div class="hero-content">
      <div class="hero-tag">
        <span class="hero-tag-dot"></span>
        <span>FW26 Collection</span>
      </div>

      <h1 class="hero-title">
        Born to<br /><span class="accent">Conquer</span>
      </h1>

      <p class="hero-subtitle">
        Engineered for the relentless. Premium athletic streetwear built for
        those who refuse to settle &mdash; on or off the field.
      </p>

      <div class="hero-ctas">
        <a href="/collections" class="btn btn-primary">
          Shop Now
          <span class="btn-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
        <a href="/new-arrivals" class="btn btn-secondary">
          View Lookbook
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="hero-scroll">
      <span class="hero-scroll-text">Scroll</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- ============================================
       Section: Shop by Category
       ============================================ -->
  <section class="categories" id="categories">
    <div class="categories-grid">
      <!-- Men Card -->
      <a href="/products/men" class="category-card reveal">
        <div class="category-card-img">
          <img src="/images/category-men.png" alt="Shop Men's Collection" loading="lazy" />
        </div>
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <span class="category-label">Engineered for Performance</span>
          <h2 class="category-title">Men</h2>
          <div class="category-cta">
            <span>Shop Men</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </div>
        <div class="category-card-shine"></div>
      </a>

      <!-- Women Card -->
      <a href="/products/women" class="category-card reveal">
        <div class="category-card-img">
          <img src="/images/category-women.png" alt="Shop Women's Collection" loading="lazy" />
        </div>
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <span class="category-label">Built Without Limits</span>
          <h2 class="category-title">Women</h2>
          <div class="category-cta">
            <span>Shop Women</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </div>
        <div class="category-card-shine"></div>
      </a>
    </div>
  </section>

  <!-- ============================================
       Section: New Drops
       ============================================ -->
  <section class="products-section" id="newDrops">
    <div class="section-container">
      <div class="section-header reveal">
        <div class="section-header-left">
          <span class="section-tag">Just Landed</span>
          <h2 class="section-title">New Drops</h2>
        </div>
        <a href="/products/new-arrivals" class="section-link">
          View All
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="products-grid">
        <% if (typeof newDrops !=='undefined' && newDrops.length> 0) { %>
          <% for (let i=0; i < newDrops.length; i++) { %>
            <div class="product-card reveal">
              <a href="/products/product/<%= newDrops[i].produit_id %>" class="product-card-link">
                <div class="product-card-img">
                  <img src="<%= newDrops[i].image_url %>" alt="<%= newDrops[i].nom_produit %>" loading="lazy" />
                  <div class="product-badge new">New</div>
                  <button class="product-quickadd" aria-label="Quick add">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </button>
                </div>
                <div class="product-card-info">
                  <div class="product-colors">
                    <span class="color-dot" style="background: #1a1a1a;" title="Black"></span>
                  </div>
                  <h3 class="product-name">
                    <%= newDrops[i].nom_produit %>
                  </h3>
                  <p class="product-price">$<%= newDrops[i].produit_prix %>
                  </p>
                </div>
              </a>
            </div>
            <% } %>
              <% } %>
      </div>
    </div>
  </section>

  <!-- ============================================
       Section: On Sale
       ============================================ -->
  <section class="products-section sale-section" id="onSale">
    <div class="section-container">
      <div class="section-header reveal">
        <div class="section-header-left">
          <span class="section-tag sale-tag">Limited Time</span>
          <h2 class="section-title">On Sale</h2>
        </div>
        <a href="/products" class="section-link">
          View All
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="products-grid">
        <% if (typeof allProducts !=='undefined' && allProducts.length> 0) { %>
          <% for (let i=0; i < allProducts.length; i++) { %>
            <div class="product-card reveal">
              <a href="/products/product/<%= allProducts[i].produit_id %>" class="product-card-link">
                <div class="product-card-img">
                  <img src="<%= allProducts[i].image_url %>" alt="<%= allProducts[i].nom_produit %>" loading="lazy" />
                  <button class="product-quickadd" aria-label="Quick add">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </button>
                </div>
                <div class="product-card-info">
                  <div class="product-colors">
                    <span class="color-dot" style="background: #1a1a1a;" title="Black"></span>
                  </div>
                  <h3 class="product-name">
                    <%= allProducts[i].nom_produit %>
                  </h3>
                  <p class="product-price">$<%= allProducts[i].produit_prix %>
                  </p>
                </div>
              </a>
            </div>
            <% } %>
              <% } %>
      </div>
    </div>
  </section>

  <!-- ============================================
       Footer
       ============================================ -->
  <footer class="site-footer" id="footer">
    <!-- Newsletter Banner -->
    <div class="footer-newsletter reveal">
      <div class="newsletter-content">
        <h3 class="newsletter-title">Join the <span>Movement</span></h3>
        <p class="newsletter-sub">Be first to know about new drops, exclusive offers, and athlete stories.</p>
        <form class="newsletter-form" id="newsletterForm">
          <div class="newsletter-input-wrap">
            <input type="email" class="newsletter-input" placeholder="Enter your email" required />
            <button type="submit" class="newsletter-btn">
              <span>Subscribe</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Footer Columns -->
    <div class="footer-main">
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-col footer-brand">
          <a href="/" class="footer-logo">
            <img src="/images/logo.png" alt="NOIRE" class="footer-logo-img" />
          </a>
          <p class="footer-brand-text">Engineered for the relentless. Premium athletic streetwear for those who refuse
            to settle.</p>
          <div class="footer-socials">
            <a href="#" class="footer-social" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="5" />
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" />
              </svg>
            </a>
            <a href="#" class="footer-social" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
              </svg>
            </a>
            <a href="#" class="footer-social" aria-label="Twitter / X">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 4l16 16M20 4L4 20" />
              </svg>
            </a>
            <a href="#" class="footer-social" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="5" width="20" height="14" rx="4" />
                <polygon points="10,8.5 16,12 10,15.5" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Shop Column -->
        <div class="footer-col">
          <h4 class="footer-col-title">Shop</h4>
          <ul class="footer-links">
            <li><a href="/new-arrivals">New Arrivals</a></li>
            <li><a href="/men">Men</a></li>
            <li><a href="/women">Women</a></li>
            <li><a href="/products">All Products</a></li>
            <li><a href="/sale">Sale</a></li>
          </ul>
        </div>

        <!-- Support Column -->
        <div class="footer-col">
          <h4 class="footer-col-title">Support</h4>
          <ul class="footer-links">
            <li><a href="/contact">Contact Us</a></li>
            <li><a href="/shipping">Shipping & Returns</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/size-guide">Size Guide</a></li>
            <li><a href="/track-order">Track Order</a></li>
          </ul>
        </div>

        <!-- Company Column -->
        <div class="footer-col">
          <h4 class="footer-col-title">Company</h4>
          <ul class="footer-links">
            <li><a href="/about">Our Story</a></li>
            <li><a href="/athletes">Athletes</a></li>
            <li><a href="/sustainability">Sustainability</a></li>
            <li><a href="/careers">Careers</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; 2026 NOIRE. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
  </footer>

  <!-- ============================================
       Inline JavaScript
       ============================================ -->
  <script>
    (function () {
      'use strict';

      /* ---------- Page Loader ---------- */
      window.addEventListener('load', () => {
        const loader = document.getElementById('pageLoader');
        setTimeout(() => loader.classList.add('loaded'), 2200);
      });

      /* ---------- Cursor Glow (desktop only) ---------- */
      const glow = document.getElementById('cursorGlow');
      if (window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener('mousemove', (e) => {
          requestAnimationFrame(() => {
            glow.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
          });
        });
      } else {
        glow.style.display = 'none';
      }

      /* ---------- Navbar Scroll Effect ---------- */
      const navbar = document.getElementById('navbar');
      const announcement = document.getElementById('announcementBar');
      let lastScroll = 0;

      window.addEventListener('scroll', () => {
        const scroll = window.scrollY;

        if (scroll > 60) {
          navbar.classList.add('scrolled');
          navbar.classList.remove('has-announcement');
        } else {
          navbar.classList.remove('scrolled');
          navbar.classList.add('has-announcement');
        }

        if (scroll > 20) {
          announcement.style.transform = 'translateY(-100%)';
          announcement.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
        } else {
          announcement.style.transform = 'translateY(0)';
        }

        lastScroll = scroll;
      }, { passive: true });

      /* ---------- Hamburger / Mobile Menu ---------- */
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobileMenu');

      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
        document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
      });

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
          document.body.style.overflow = '';
        });
      });

      /* ---------- Search Overlay ---------- */
      const searchToggle = document.getElementById('searchToggle');
      const searchOverlay = document.getElementById('searchOverlay');
      const searchClose = document.getElementById('searchClose');
      const searchInput = searchOverlay.querySelector('.search-input');

      searchToggle.addEventListener('click', () => {
        searchOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => searchInput.focus(), 400);
      });

      searchClose.addEventListener('click', closeSearch);

      searchOverlay.addEventListener('click', (e) => {
        if (e.target === searchOverlay) closeSearch();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && searchOverlay.classList.contains('open')) closeSearch();
      });

      function closeSearch() {
        searchOverlay.classList.remove('open');
        document.body.style.overflow = '';
        searchInput.value = '';
      }

      /* ---------- Floating Particles ---------- */
      const particlesContainer = document.getElementById('particles');
      const PARTICLE_COUNT = 25;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const p = document.createElement('div');
        p.classList.add('particle');
        p.style.left = Math.random() * 100 + '%';
        p.style.bottom = -(Math.random() * 20) + '%';
        p.style.width = (Math.random() * 2 + 1) + 'px';
        p.style.height = p.style.width;
        p.style.animationDuration = (Math.random() * 8 + 6) + 's';
        p.style.animationDelay = (Math.random() * 10) + 's';
        p.style.opacity = '0';
        particlesContainer.appendChild(p);
      }

      /* ---------- Parallax on Floating Badges ---------- */
      const floatLeft = document.getElementById('floatLeft');
      const floatRight = document.getElementById('floatRight');

      if (window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener('mousemove', (e) => {
          const x = (e.clientX / window.innerWidth - 0.5) * 2;
          const y = (e.clientY / window.innerHeight - 0.5) * 2;

          requestAnimationFrame(() => {
            floatLeft.style.transform = `translate(${x * -12}px, ${y * -8}px)`;
            floatRight.style.transform = `translate(${x * 10}px, ${y * -10}px)`;
          });
        });
      }

      /* ---------- Hero Parallax on Scroll ---------- */
      const heroBg = document.querySelector('.hero-bg img');
      const heroContent = document.querySelector('.hero-content');

      window.addEventListener('scroll', () => {
        const scroll = window.scrollY;
        const heroH = window.innerHeight;
        if (scroll < heroH) {
          const ratio = scroll / heroH;
          requestAnimationFrame(() => {
            heroBg.style.transform = `scale(${1 + ratio * 0.08}) translateY(${scroll * 0.25}px)`;
            heroContent.style.transform = `translateY(${scroll * 0.35}px)`;
            heroContent.style.opacity = 1 - ratio * 1.2;
          });
        }
      }, { passive: true });

      /* ---------- Keyboard shortcut: Cmd/Ctrl+K for search ---------- */
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchOverlay.classList.add('open');
          document.body.style.overflow = 'hidden';
          setTimeout(() => searchInput.focus(), 400);
        }
      });

      /* ---------- Scroll Reveal (Intersection Observer) ---------- */
      const revealElements = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Stagger children if it's a product grid parent
              const parent = entry.target.closest('.products-grid');
              if (parent) {
                const siblings = Array.from(parent.querySelectorAll('.reveal'));
                const idx = siblings.indexOf(entry.target);
                entry.target.style.transitionDelay = `${idx * 0.1}s`;
              }
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      revealElements.forEach((el) => revealObserver.observe(el));

      /* ---------- Product Card Tilt (desktop) ---------- */
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll('.product-card').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width - 0.5) * 8;
            const y = ((e.clientY - rect.top) / rect.height - 0.5) * 8;
            card.style.transform = `perspective(600px) rotateY(${x}deg) rotateX(${-y}deg) scale(1.02)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
            card.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
          });
          card.addEventListener('mouseenter', () => {
            card.style.transition = 'transform 0.1s ease-out';
          });
        });
      }

      /* ---------- Newsletter Form ---------- */
      const nlForm = document.getElementById('newsletterForm');
      if (nlForm) {
        nlForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const btn = nlForm.querySelector('.newsletter-btn span');
          const original = btn.textContent;
          btn.textContent = 'Subscribed ✓';
          nlForm.querySelector('.newsletter-input').value = '';
          setTimeout(() => { btn.textContent = original; }, 3000);
        });
      }

      /* ---------- Quick Add Button Ripple ---------- */
      document.querySelectorAll('.product-quickadd').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          btn.classList.add('added');
          setTimeout(() => btn.classList.remove('added'), 1200);
        });
      });

    })();
  </script>

  <!-- Auth Panel -->
  <div class="auth-overlay" id="authOverlay"></div>
  <div class="auth-panel" id="authPanel">
    <div class="auth-header">
      <h2 id="authTitle"><%= locals.user ? 'My Account' : 'Sign In' %></h2>
      <button class="auth-close" id="authClose" aria-label="Close login">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <% if (locals.user) { %>
      <div style="padding: 20px; text-align: center;">
        <p style="margin-bottom: 20px;">Welcome back! You are currently signed in.</p>
        <a href="/auth/logout" class="auth-submit-btn" style="text-decoration: none; display: inline-block; width: 100%; box-sizing: border-box; text-align: center;">Sign Out</a>
      </div>
    <% } else { %>
      <button class="auth-google-btn" id="google-Btn">
        <svg viewBox="0 0 24 24">
          <path fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        <span>Continue with Google</span>
      </button>
      <div class="auth-divider">or</div>
      <form class="auth-form" id="authForm">
        <div class="auth-input-group" id="authNameGroup" style="display: none;">
          <label for="authName">Name</label>
          <input type="text" id="authName" placeholder="Enter your full name" />
        </div>
        <div class="auth-input-group">
          <label for="authEmail">Email</label>
          <input type="email" id="authEmail" placeholder="Enter your email" required />
        </div>
        <div class="auth-input-group">
          <label for="authPassword">Password</label>
          <input type="password" id="authPassword" placeholder="Enter your password" required />
        </div>
        <button type="submit" class="auth-submit-btn" id="authSubmitBtn">Sign In</button>
      </form>
      <div class="auth-footer">
        <span id="authFooterText">Don't have an account?</span> <a href="#" id="authToggleMode">Sign up</a>
      </div>
    <% } %>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>

  <script>
    /* ---------- Toast Notification System ---------- */
    function showToast({ type = 'info', title = '', message = '', duration = 4500 } = {}) {
      const container = document.getElementById('toastContainer');

      const icons = {
        success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>',
        error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
        info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
        warning: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
      };

      const toast = document.createElement('div');
      toast.className = `toast toast--${type}`;
      toast.innerHTML = `
        <div class="toast-icon">${icons[type] || icons.info}</div>
        <div class="toast-body">
          <div class="toast-title">${title}</div>
          <div class="toast-message">${message}</div>
        </div>
        <button class="toast-close" aria-label="Dismiss">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <div class="toast-progress" style="animation-duration: ${duration}ms;"></div>
      `;

      container.appendChild(toast);

      function dismiss() {
        if (toast.classList.contains('toast-exit')) return;
        toast.classList.add('toast-exit');
        toast.addEventListener('animationend', () => toast.remove());
      }

      toast.querySelector('.toast-close').addEventListener('click', dismiss);

      setTimeout(dismiss, duration);
    }

    /* ---------- Check URL params for redirect notifications ---------- */
    (function () {
      const params = new URLSearchParams(window.location.search);
      const notify = params.get('notify');

      if (notify === 'google_success') {
        showToast({ type: 'success', title: 'Welcome back!', message: 'You have been signed in with Google successfully.' });
      } else if (notify === 'logged_out') {
        showToast({ type: 'info', title: 'Signed out', message: 'You have been signed out successfully. See you next time!' });
      } else if (notify === 'signin_success') {
        showToast({ type: 'success', title: 'Welcome back!', message: 'You have been signed in successfully.' });
      }

      // Clean the URL without reloading
      if (notify) {
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      }
    })();

    /* ---------- Auth Panel Toggle ---------- */
    const authToggles = document.querySelectorAll('.auth-toggle');
    const authOverlay = document.getElementById('authOverlay');
    const authPanel = document.getElementById('authPanel');
    const authClose = document.getElementById('authClose');
    function openAuth(e) { e.preventDefault(); authOverlay.classList.add('open'); authPanel.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeAuth() { authOverlay.classList.remove('open'); authPanel.classList.remove('open'); document.body.style.overflow = ''; }
    authToggles.forEach(t => t.addEventListener('click', openAuth));
    if (authClose) authClose.addEventListener('click', closeAuth);
    if (authOverlay) authOverlay.addEventListener('click', closeAuth);

    //login and signup submition
    const authForm = document.getElementById('authForm');
    const authSubmitBtn = document.getElementById('authSubmitBtn');
    const authToggleMode = document.getElementById('authToggleMode');
    const authTitle = document.getElementById('authTitle');
    const authNameGroup = document.getElementById('authNameGroup');
    const authFooterText = document.getElementById('authFooterText');
    const googleBtn = document.getElementById('google-Btn');
    let isSignUp = false;

    if (googleBtn) {
      googleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        showToast({ type: 'info', title: 'Redirecting...', message: 'Taking you to Google sign-in.', duration: 3000 });
        setTimeout(() => { window.location.href = '/auth/google'; }, 600);
      });
    }

    if (authToggleMode) {
      authToggleMode.addEventListener('click', (e) => {
        e.preventDefault();
        isSignUp = !isSignUp;
        if (isSignUp) {
          authTitle.textContent = 'Create Account';
          authNameGroup.style.display = 'flex';
          authNameGroup.querySelector('input').required = true;
          authSubmitBtn.textContent = 'Sign Up';
          authFooterText.textContent = 'Already have an account?';
          authToggleMode.textContent = 'Sign in';
        } else {
          authTitle.textContent = 'Sign In';
          authNameGroup.style.display = 'none';
          authNameGroup.querySelector('input').required = false;
          authSubmitBtn.textContent = 'Sign In';
          authFooterText.textContent = "Don't have an account?";
          authToggleMode.textContent = 'Sign up';
        }
      });
    }


    if (authForm) {
      authForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = {
          name: document.getElementById('authName').value,
          email: document.getElementById('authEmail').value,
          password: document.getElementById('authPassword').value
        };

        try {
          const response = await fetch(isSignUp ? '/auth/sign-up' : '/auth/sign-in', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!response.ok) {
            showToast({ type: 'error', title: 'Something went wrong', message: result.error || result.message || 'Please try again later.' });
            return;
          }

          if (isSignUp) {
            showToast({ type: 'success', title: 'Account created!', message: result.message || 'Your account has been created. You can now sign in.' });
            // Switch back to sign-in mode
            if (authToggleMode) authToggleMode.click();
          } else {
            showToast({ type: 'success', title: 'Welcome back!', message: result.message || 'You have been signed in successfully.' });
            closeAuth();
            // Reload after a short delay so the user sees the toast
            setTimeout(() => { window.location.href = '/?notify=signin_success'; }, 1200);
          }
        } catch (err) {
          showToast({ type: 'error', title: 'Network Error', message: 'Could not reach the server. Please check your connection and try again.' });
        }
      });
    }



  </script>
</body>

</html>